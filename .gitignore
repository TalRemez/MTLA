# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Bulk research artifacts — never commit (features are ~1 TB, predictions ~27 GB)
features/
predictions/
artifacts/
checkpoints*/
outputs/
results*/
*.safetensors
*.bin
*.pth

# Datasets (download separately; see docs/DATA.md). Anchored to repo root so they don't
# shadow the mtla/data/ package.
/datasets/
/data/

# Audio cascade (AudioSet / Audio Flamingo 3): separate research code, not part of this
# repo's unified image/video pipeline. Kept out of the public tree on purpose; the audio
# results in the README are reported numbers, not reproduced here.
/cascade/

# Attention/feature shards anywhere (regenerated by the extract stage; never committed)
*.pt

# Scratch output
*.tmp

# Agent handover notes — local only, never push
HANDOVER_AGENT.md

# Internal parity-golden reference — kept locally, not published
docs/PARITY_GOLDEN.md

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
